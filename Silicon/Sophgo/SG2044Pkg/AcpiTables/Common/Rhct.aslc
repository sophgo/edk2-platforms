/** @file
  RISC-V Hart Capabilities Table (RHCT)

  A new ACPI table named as RISC-V Hart Capabilities Table (RHCT).
  This table is required to communicate certain capabilities of
  RISC-V Hart (hardware thread) to the Operating System.

  Copyright (c) 2024, SOPHGO Inc. All rights reserved.
  Copyright (c) 2020 - 2022, Arm Limited. All rights reserved.

  SPDX-License-Identifier: BSD-2-Clause-Patent

  @par Specification Reference:
    - ACPI 6.5, Chapter 5, Section 5.2.12, Multiple APIC Description Table
**/

#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include "SG2044AcpiHeader.h"

#define SG2044_ISA_STRING                                                   \
  "rv64imafdcv_zicbom_zicbop_zicboz_zicntr_zicond_zicsr"                  \
  "_zifencei_zawrs_zba_zbb_zbc_zbs_zca_zcb_zcd_zfa_zfbfmin"               \
  "_zfh_zfhmin_zihintntl_zihintpause_zihpm"                                \
  "_zvfbfmin_zvfbfwma_zvfh_zvfhmin_sscofpmf_sstc_svinval_svnapot_svpbmt"

// Multiple APIC Description Table
#pragma pack (1)

typedef struct {
  EFI_ACPI_6_6_RISCV_HART_CAPABILITIES_TABLE    Header;
  SG2044_RHCT_ISA_STRING_NODE                   ISAStrNode;
  EFI_ACPI_6_6_RHCT_CMO_NODE                    CMONode;
  EFI_ACPI_6_6_RHCT_MMU_NODE                    MMUNode;
  SG2044_RHCT_HART_INFO_NODE                    HartInfoNode[64];
} SG2044_RHCT_TABLE;

#pragma pack ()

STATIC SG2044_RHCT_TABLE Rhct = {
  {
    RISCV_ACPI_HEADER (
      EFI_ACPI_6_6_RISCV_HART_CAPABILITIES_TABLE_SIGNATURE,
      SG2044_RHCT_TABLE,
      EFI_ACPI_6_6_RHCT_TABLE_REVISION
    ),
    // RHCT specific fields
    0,                      // Flags
    50000000,               // Time Base Frequency
    67,                     // Number of RHCT nodes
    RHCT_NODE_ARRAY_OFFSET  // Offset to the RHCT node array
  },
  {
    0,
    OFFSET_OF (SG2044_RHCT_TABLE, CMONode) - OFFSET_OF (SG2044_RHCT_TABLE, ISAStrNode),                     // 8 + N + P: Size of this structure.
    1,
    sizeof (SG2044_ISA_STRING),
    SG2044_ISA_STRING
  },
  {
    {1, 10, 1},
    0,
    6,
    6,
    6
  },
  {
    {2, 8, 1},
    0,
    1
  },
  {
    SG2044_RHCT_HART_INFO_NODE_INIT (0),
    SG2044_RHCT_HART_INFO_NODE_INIT (1),
    SG2044_RHCT_HART_INFO_NODE_INIT (2),
