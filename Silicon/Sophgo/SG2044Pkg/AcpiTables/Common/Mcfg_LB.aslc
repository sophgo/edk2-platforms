/** @file
  Memory mapped configuration space base address description table (MCFG)

  The MCFG table provides the address of the PCI configuration space, which
  is required by the OS to perform the PCIe bus enumeration.

  Copyright (c) 2024, SOPHGO Inc. All rights reserved.
  Copyright (c) 2018 - 2022, Arm Limited. All rights reserved.

  SPDX-License-Identifier: BSD-2-Clause-Patent

  @par Specification Reference:
    - http://www.pcisig.com/home
**/

#include <IndustryStandard/MemoryMappedConfigurationSpaceAccessTable.h>
#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include "SG2044AcpiHeader.h"

#pragma pack(1)
typedef struct
{
  EFI_ACPI_MEMORY_MAPPED_CONFIGURATION_BASE_ADDRESS_TABLE_HEADER Header;
  EFI_ACPI_MEMORY_MAPPED_ENHANCED_CONFIGURATION_SPACE_BASE_ADDRESS_ALLOCATION_STRUCTURE Structure[10];
} EFI_ACPI_PCI_MEMORY_MAPPED_CONFIGURATION_SPACE_ACCESS_DESCRIPTION_TABLE;
#pragma pack()

EFI_ACPI_PCI_MEMORY_MAPPED_CONFIGURATION_SPACE_ACCESS_DESCRIPTION_TABLE Mcfg = {
  {
    RISCV_ACPI_HEADER (
      EFI_ACPI_6_5_PCI_EXPRESS_MEMORY_MAPPED_CONFIGURATION_SPACE_BASE_ADDRESS_DESCRIPTION_TABLE_SIGNATURE,
      EFI_ACPI_PCI_MEMORY_MAPPED_CONFIGURATION_SPACE_ACCESS_DESCRIPTION_TABLE,
      EFI_ACPI_MEMORY_MAPPED_CONFIGURATION_SPACE_ACCESS_TABLE_REVISION
    ),
    EFI_ACPI_RESERVED_QWORD, // Reserved
  },
  {
    // PCIe ECAM
    // Segment 0 (C2C0 Wrapper0 x8): config window relocated below 4G to free
    // the 128G C2C0 aperture (0x40_00000000-0x5F_FFFFFFFF) for a single
    // prefetchable BAR. SG2044 uses a 4K config window + iATU (not real ECAM),
    // so only the base address matters here (kernel cfg0_base).
    {
      0x40000000,                                           // Base Address
      0x0,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x4800000000,                                         // Base Address
      0x1,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x5000000000,                                         // Base Address
      0x2,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x5800000000,                                         // Base Address
      0x3,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x7800000000,                                         // Base Address
      0x4,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x7a00000000,                                         // Base Address
      0x5,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x7c00000000,                                         // Base Address
      0x6,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x7e00000000,                                         // Base Address
      0x7,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x6000000000,                                         // Base Address
      0x8,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    },
    {
      0x6400000000,                                         // Base Address
      0x9,                                                  // Segment Group Number
      0x0,                                                  // Start Bus Number
      0xff,                                                 // End Bus Number
      0x00000000,                                           // Reserved
    }
  }
};

//
// Reference the table being generated to prevent the optimizer from removing the
// data structure from the executable
//
VOID* CONST ReferenceAcpiTable = &Mcfg;
