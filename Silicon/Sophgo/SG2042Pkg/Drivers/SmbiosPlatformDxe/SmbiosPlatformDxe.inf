[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = SmbiosPlatformDxe
  FILE_GUID                      = 1CAFAAC3-C386-BF0B-7DD1-7EEE514A91B1
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SmbiosPlatformDriverEntryPoint

[Sources]
  SmbiosPlatformDxe.c
  SmbiosPlatformDxe.h
  SmbiosDataSG2042EVB.c
  SmbiosDataMilkVPioneer.c
  SmbiosDataSRA120.c

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Silicon/Sophgo/Sophgo.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  HobLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  RiscVSbiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiSmbiosProtocolGuid                      # PROTOCOL ALWAYS_CONSUMED
  gSophgoSmbiosPlatformReadyProtocolGuid      ## PRODUCES

[Pcd]
  gSophgoTokenSpaceGuid.PcdBiosVersionString
  gSophgoTokenSpaceGuid.PcdSmbiosBoardType
  gSophgoTokenSpaceGuid.PcdSmbiosHartCount

[Depex]
  gEfiSmbiosProtocolGuid
