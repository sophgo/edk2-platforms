#include "BmcConfigNv.h"

formset
  guid      = BMC_FORMSET_GUID,
  title     = STRING_TOKEN(STR_BMC_CONFIG_TITLE),
  help      = STRING_TOKEN(STR_BMC_CONFIG_HELP),
  classguid = BMC_FORMSET_GUID,

  varstore BMC_DATA,
    varid = VAR_BMC_VARID,
    name  = BMCConfigData,
    guid  = gEfiSophgoGlobalVariableGuid;

 form formid = BMC_FORM_ID,
       title = STRING_TOKEN(STR_BMC_FORM_TITLE);
       goto NETWORK_SET_FORM_ID,
             prompt  = STRING_TOKEN(STR_NETWORK_SET_PROMPT),
             help    = STRING_TOKEN(STR_NETWORK_SET_HELP),
             flags   = INTERACTIVE,
             key     = NETWORK_SET_FORM_ID;
       goto MAC_ADDR_FORM_ID,
             prompt  = STRING_TOKEN(STR_MAC_SET_PROMPT),
             help    = STRING_TOKEN(STR_MAC_SET_HELP),
             flags   = INTERACTIVE,
             key     = MAC_ADDR_FORM_ID;
       goto BASIC_INFO_FORM_ID,
             prompt  = STRING_TOKEN(STR_BMC_BASIC_INFO_PROMPT),
             help    = STRING_TOKEN(STR_BMC_BASIC_INFO_HELP),
             flags   = INTERACTIVE,
             key     = BASIC_INFO_FORM_ID;
       goto BMC_USER_FORM_ID,
             prompt  = STRING_TOKEN(STR_MAC_USER_MANAGER_PROMPT),
             help    = STRING_TOKEN(STR_MAC_USER_MANAGER_HELP),
             flags   = INTERACTIVE,
             key     = BMC_USER_FORM_ID;

  endform;
  form formid = NETWORK_SET_FORM_ID,
     title = STRING_TOKEN(STR_BMC_SET_FORM_TITLE);
     oneof varid        = BMCConfigData.EnableDHCP,
           questionid   = DHCP_QUESTION_ID,
           prompt       = STRING_TOKEN(STR_DHCP_PROMPT),
           help         = STRING_TOKEN(STR_DHCP_HELP),
           flags        = INTERACTIVE,
           option text  = STRING_TOKEN(STR_DHCP_ENABLED), value = 0x02,  flags = 0;
           option text  = STRING_TOKEN(STR_DHCP_DISABLED), value = 0x01, flags = 0;
     endoneof;
     suppressif ideqval BMCConfigData.EnableDHCP == 2;
      label LABEL_SET;
      label LABEL_END;
      endif;
      /*text
       help     = STRING_TOKEN(STR_REFRESH_HELP),
       text     = STRING_TOKEN(STR_REFRESH_PROMPT),
       flags    = INTERACTIVE,
       key      = REFRESH_QUESTION_ID;*/
  endform;
  form formid = MAC_ADDR_FORM_ID,
      title = STRING_TOKEN(STR_MAC_SET_TITLE);
      label LABEL_MAC_START;
      label LABEL_MAC_END;
      /*text
       help     = STRING_TOKEN(STR_REFRESH_HELP),
       text     = STRING_TOKEN(STR_REFRESH_PROMPT),
       flags    = INTERACTIVE,
       key      = MAC_ADDR_REFRESH_ID;*/
  endform;
  form formid = BASIC_INFO_FORM_ID,
      title = STRING_TOKEN(STR_BMC_BASIC_INFO_TITLE);
      label LABEL_INFO_START;
      label LABEL_INFO_END;
      /*text
       help     = STRING_TOKEN(STR_REFRESH_HELP),
       text     = STRING_TOKEN(STR_REFRESH_PROMPT),
       flags    = INTERACTIVE,
       key      = BASIC_INFO_REFRESH_ID;*/
  endform;
  form formid = BMC_USER_FORM_ID,
      title = STRING_TOKEN(STR_MAC_USER_MANAGER_PROMPT);
      subtitle text  = STRING_TOKEN(STR_BMC_USER_TOTAL_NUM);

      /*text
       help   = STRING_TOKEN(STR_EMPTY),
       text   = STRING_TOKEN(STR_BMC_ADMIN_NAME),
       text   = STRING_TOKEN(STR_BMC_USER_NAME_VAL_0);

      password
       varid    = BMCConfigData.UserConfigData.UserEntry[0].Password,
       prompt   = STRING_TOKEN(STR_BMC_ADMIN_PASSWORD),
       help     = STRING_TOKEN(STR_EMPTY),
       flags    = INTERACTIVE,
       key      = KEY_PASSWORD_0,
       minsize  = MIN_LEN_USER_PASSWORD,
       maxsize  = MAX_LEN_USER_PASSWORD,
      endpassword;*/

      suppressif ideqval BMCConfigData.UserConfigData.UserEntry[1].Flag == 0;
       subtitle text  = STRING_TOKEN(STR_EMPTY);
       text
        help   = STRING_TOKEN(STR_EMPTY),
        text   = STRING_TOKEN(STR_BMC_USER_NAME),
        text   = STRING_TOKEN(STR_BMC_USER_NAME_VAL_1);

       password
        varid    = BMCConfigData.UserConfigData.UserEntry[1].Password,
        prompt   = STRING_TOKEN(STR_BMC_USER_PASSWORD),
        help     = STRING_TOKEN(STR_EMPTY),
        flags    = INTERACTIVE,
        key      = KEY_PASSWORD_1,
        minsize  = MIN_LEN_USER_PASSWORD,
        maxsize  = MAX_LEN_USER_PASSWORD,
       endpassword;
      endif;

