[Defines]
  DEC_SPECIFICATION              = 0x0001001B
  PACKAGE_NAME                   = SG2044Pkg
  PACKAGE_UNI_FILE               = SG2044Pkg.uni
  PACKAGE_GUID                   = FBC87EA0-24B3-4608-8F75-86A368176B55
  PACKAGE_VERSION                = 1.0

[Includes.common]
  Include                        # Root include for the package

[Guids]
  gSophgoSG2044PlatformPkgTokenSpaceGuid = { 0xC7332EAB, 0xF58E, 0x40D1, { 0xBF, 0x63, 0xBE, 0x1D, 0x50, 0xC3, 0xBE, 0x49 } }

[LibraryClasses]
  ##  @libraryclass  Provides per-platform PCIe slot descriptions
  #   (board slot table lookup by PCIe domain / device path).
  #
  PcieSlotInfoLib|Include/Library/PcieSlotInfoLib.h

[Protocols]
  gSophgoSmbiosPlatformReadyProtocolGuid = { 0xA4E21C8F, 0x6D3B, 0x4E92, { 0x9C, 0x01, 0x2F, 0x8A, 0x5B, 0x71, 0xD0, 0x44 } }

[UserExtensions.TianoCore."ExtraFiles"]
